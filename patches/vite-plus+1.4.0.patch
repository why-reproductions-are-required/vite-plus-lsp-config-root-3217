+import path from "node:path";
+import { loadConfigFromFile, resolveConfig } from "vite";
+import { u as withConfigMetadataResolution } from "./define-config-ChwJcu5e.js";
+
+// Experimental implementation of the proposal in vite-plus#3217.
+// Keep its compatibility differences observable in the reproduction.
+export async function resolveConfigFile(configFile) {
+  return withConfigMetadataResolution(async () => {
+    const configEnv = { command: "build", mode: "development", isSsrBuild: false, isPreview: false };
+    const loaded = await loadConfigFromFile(configEnv, configFile);
+    const root = path.resolve(path.dirname(configFile), loaded.config.root ?? "");
+    const config = await resolveConfig({ ...loaded.config, root, configFile: false }, "build");
+    config.configFile = loaded.path;
+    config.configFileDependencies = loaded.dependencies;
+    return config;
+  });
+}
